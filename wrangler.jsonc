{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "judge-buddy",
  "main": "cf/src/index.ts",
  "compatibility_date": "2025-11-01",

  // ethers v6 reaches for node:crypto, node:buffer and node:stream.
  "compatibility_flags": ["nodejs_compat"],

  // Vite output. The API lives at /api/*; everything else falls through to the SPA so
  // client-side routes like /hackathon/live survive a hard refresh (the old Vercel deploy
  // returned 404 on deep links).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Custom domain. Wrangler provisions the DNS record and the cert on the l17s.dev zone.
  "routes": [
    { "pattern": "judge-buddy.l17s.dev", "custom_domain": true }
  ],

  // Keep the workers.dev URL alive as a fallback; adding a route disables it otherwise.
  "workers_dev": true,

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "judge-buddy",
      "database_id": "61d65ffc-8dca-4ad2-b174-9cec5f123795"
    }
  ],

  // Scoring agents. Replaces the OpenAI dependency: no third-party key, and inference runs
  // on the same account the app is deployed to.
  "ai": {
    "binding": "AI"
  },

  // Drains the job queue. The worker loop used to be a `for(;;)` with a 3s sleep, which has
  // no equivalent on Workers.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "vars": {
    "HEDERA_NETWORK": "testnet",
    "HEDERA_EVM_RPC": "https://testnet.hashio.io/api",
    "HEDERA_MIRROR_BASE": "https://testnet.mirrornode.hedera.com",
    "HEDERA_CHAIN_ID": "296",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "JOBS_PER_CRON": "5",

    // Deployed 2026-07-27 to Hedera testnet. These live here rather than being passed as
    // `wrangler deploy --var` flags: CLI vars are per-invocation and a later deploy without them
    // silently wipes the values, which leaves the pipeline running with the chain disabled.
    //
    // Second generation. The first treasury (0xF862f3e4…11fE) had to be retired: its claim token
    // was transferred to it before the HTS collection existed, and initializeClaimCollection is
    // onlyOwner with no passthrough, so the claim branch was unreachable for good. The treasury
    // now exposes that passthrough — see HackathonTreasury.initializeClaimCollection.
    "TREASURY_CONTRACT_ADDRESS": "0xd93128FEE6773F552F5EC67FDddD3c1fa882fd69",
    "PRIZE_CLAIM_TOKEN_ADDRESS": "0xAc370628C1Ba5d03d5cfB594262daf70cdB5d855",

    // Unchanged across the redeploy: the payout asset is named per hackathon at bootstrap,
    // so it is not tied to a treasury instance.
    "PAYOUT_TOKEN_ADDRESS": "0x398cAFe2C8d16BdF6c970D3e251A899A481a0D4D",

    // Display identity of the payout token. The UI reads these from /api/health at runtime;
    // they also feed the clear-signing manifest summary. They must never come from a
    // build-time VITE_ var — the first deployed bundle shipped without it and labelled
    // every jbUSD amount "USDC".
    "PAYOUT_TOKEN_SYMBOL": "jbUSD",
    "PAYOUT_TOKEN_DECIMALS": "6"
  }

  // Secrets, set with `wrangler secret put`:
  //   SESSION_SECRET               HMAC key for signed session cookies
  //   TREASURY_RELAYER_PRIVATE_KEY agent relayer, signs registerSubmission/proposeAward/payout
  //
  // HTS prize-claim collection: 0.0.9798702 (JudgeBuddy Prize Claim / JBPC), owned by the
  // PrizeClaimToken contract. Claims are minted to that contract and burned on redemption, so a
  // winner never needs to associate with the collection to be paid.
}
