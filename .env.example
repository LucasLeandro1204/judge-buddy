# Deploy keys for the hardhat scripts and the on-chain demo bootstrap.
# The deployed Worker does NOT read this file — it takes vars from wrangler.jsonc
# and secrets from `wrangler secret put`.

# Hedera JSON-RPC endpoint (testnet)
# HEDERA_EVM_RPC=https://testnet.hashio.io/api

# Deployer wallet for `npm run deploy:treasury:testnet` (never commit)
# DEPLOYER_EVM_PRIVATE_KEY=0x...

# Demo bootstrap (scripts/bootstrap-demo.cjs, scripts/settle-claim-award.cjs)
# TREASURY_CONTRACT_ADDRESS=0x...
# PAYOUT_TOKEN_ADDRESS=0x...
# TREASURY_AGENT_RELAYER=0x...
# JUDGE_ACCOUNT_ID=0.0.x
# JUDGE_PRIVATE_KEY=302e...
# API_BASE=https://judge-buddy.l17s.dev

# Optional pre-load fallback for the frontend; the UI reads the real token
# identity from /api/health at runtime.
# VITE_PAYOUT_TOKEN_SYMBOL=jbUSD
# VITE_PAYOUT_TOKEN_DECIMALS=6
