{
  "name": "judge-copilot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:worker": "npm --prefix worker run dev",
    "dev:all": "concurrently -n web,api,worker -c blue,magenta,cyan \"npm run dev\" \"npm run dev:server\" \"npm run dev:worker\"",
    "compile:escrow": "hardhat compile",
    "compile:treasury": "hardhat compile",
    "deploy:escrow:testnet": "hardhat run scripts/deploy-escrow.cjs --network hedera_testnet",
    "deploy:treasury:testnet": "hardhat run scripts/deploy-treasury.cjs --network hedera_testnet",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "workspaces": [
    "./server",
    "./worker",
    "./packages/*"
  ],
  "dependencies": {
    "@hashgraph/hedera-wallet-connect": "^2.1.2",
